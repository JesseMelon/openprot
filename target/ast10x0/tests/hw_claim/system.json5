// Deliberately broken system: two processes are granted the same FMC register
// block, and both apps claim it. The image assembles; the hardware claim check
// is what rejects it.
{
    arch: {
        type: "armv7m",
        vector_table_start_address: 0x00000000,
        vector_table_size_bytes: 1280,
    },
    kernel: {
        flash_start_address: 0x00000500,
        flash_size_bytes: 129792,
        ram_start_address: 0x00060000,
        ram_size_bytes: 131072,
    },
    apps: [
        {
            name: "claim_a",
            flash_size_bytes: 65536,
            processes: [
                {
                    name: "claim_a_process",
                    ram_size_bytes: 32768,
                    objects: [
                        {
                            type: "thread",
                            name: "claim_a_thread",
                            kernel_stack_size_bytes: 2048,
                        },
                    ],
                    memory_mappings: [
                        {
                            name: "fmc_regs",
                            type: "device",
                            start_address: 0x7e620000,
                            size_bytes: 0x1000,
                        },
                    ],
                },
            ],
        },
        {
            name: "claim_b",
            flash_size_bytes: 65536,
            processes: [
                {
                    name: "claim_b_process",
                    ram_size_bytes: 32768,
                    objects: [
                        {
                            type: "thread",
                            name: "claim_b_thread",
                            kernel_stack_size_bytes: 2048,
                        },
                    ],
                    memory_mappings: [
                        {
                            name: "fmc_regs",
                            type: "device",
                            start_address: 0x7e620000,
                            size_bytes: 0x1000,
                        },
                    ],
                },
            ],
        },
    ],
}
