load("@pigweed//pw_kernel/tooling:system_image.bzl", "system_image")
load("@pigweed//pw_kernel/tooling:target_codegen.bzl", "target_codegen")
load("@pigweed//pw_kernel/tooling:target_linker_script.bzl", "target_linker_script")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//target/ast10x0:defs.bzl", "TARGET_COMPATIBLE_WITH")
load("//util/hw_claim:defs.bzl", "hw_claim_test", "rust_app")
load("//util/region:defs.bzl", "app_regions")

filegroup(
    name = "system_config",
    srcs = ["system.json5"],
)

target_codegen(
    name = "codegen",
    arch = "@pigweed//pw_kernel/arch/arm_cortex_m:arch_arm_cortex_m",
    system_config = ":system_config",
    target_compatible_with = TARGET_COMPATIBLE_WITH,
)

target_linker_script(
    name = "linker_script",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    template = "//target/ast10x0:linker_script_template",
)

rust_binary(
    name = "target",
    srcs = ["target.rs"],
    edition = "2024",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        ":codegen",
        ":linker_script",
        "//target/ast10x0:entry",
        "@pigweed//pw_kernel/arch/arm_cortex_m:arch_arm_cortex_m",
        "@pigweed//pw_kernel/kernel",
        "@pigweed//pw_kernel/subsys/console:console_backend",
        "@pigweed//pw_kernel/target:target_common",
        "@pigweed//pw_kernel/userspace",
    ],
)

app_regions(
    name = "app_claim_a_regions",
    app_name = "claim_a",
    edition = "2024",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
)

app_regions(
    name = "app_claim_b_regions",
    app_name = "claim_b",
    edition = "2024",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
)

rust_app(
    name = "claim_a",
    srcs = ["a_main.rs"],
    codegen_crate_name = "app_claim_a",
    edition = "2024",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        ":app_claim_a_regions",
        "//util/hw_claim",
        "@pigweed//pw_kernel/userspace",
    ],
)

rust_app(
    name = "claim_b",
    srcs = ["b_main.rs"],
    codegen_crate_name = "app_claim_b",
    edition = "2024",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        ":app_claim_b_regions",
        "//util/hw_claim",
        "@pigweed//pw_kernel/userspace",
    ],
)

# No `target_compatible_with`: `system_image` transitions the kernel and apps to
# `//target/ast10x0` itself, so the image and the host-side check below build
# from any config.
system_image(
    name = "conflict_image",
    apps = [
        ":claim_a",
        ":claim_b",
    ],
    kernel = ":target",
    platform = "//target/ast10x0",
    system_config = ":system_config",
    tags = ["kernel"],
)

# Passes only if the check rejects the image: two apps take 0x7e620000.
hw_claim_test(
    name = "conflict_detected_test",
    expect_conflict = True,
    image = ":conflict_image",
)
