// Minimal dual-EVB boot test: kernel + shutdown app only.
// Stepping stone toward the full mctp_server_test.
{
    arch: {
        type: "armv7m",
        vector_table_start_address: 0x00000000,
        vector_table_size_bytes: 2048,
    },
    kernel: {
        flash_start_address: 0x00000800,
        flash_size_bytes: 129024,
        ram_start_address: 0x00060000,
        ram_size_bytes: 131072,
    },
    apps: [
        {
            name: "i2c_server",
            flash_size_bytes: 131072,
            processes: [
                {
                    name: "i2c_server_process",
                    ram_size_bytes: 65536,
                    objects: [
                        {
                            name: "wg",
                            type: "wait_group",
                        },
                        {
                            name: "i2c",
                            type: "channel_handler",
                        },
                        {
                            name: "i2c2_irq",
                            type: "interrupt",
                            irqs: [
                                {
                                    name: "i2c2",
                                    number: 112,
                                },
                            ],
                        },
                    ],
                    memory_mappings: [
                        {
                            name: "i2c_regs",
                            type: "device",
                            start_address: 0x7e7b0000,
                            size_bytes: 0x4000,
                        },
                    ],
                    threads: [
                        {
                            name: "i2c_server_thread",
                            kernel_stack_size_bytes: 4096,
                        },
                    ],
                },
            ],
        },
        {
            name: "mctp_nop_shutdown",
            flash_size_bytes: 32768,
            processes: [
                {
                    name: "mctp_nop_shutdown_process",
                    ram_size_bytes: 16384,
                    objects: [],
                    threads: [
                        {
                            name: "mctp_nop_shutdown_thread",
                            kernel_stack_size_bytes: 2048,
                        },
                    ],
                },
            ],
        },
    ],
}
