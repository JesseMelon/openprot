load("@pigweed//pw_kernel/tooling:rust_app.bzl", "rust_app")
load("@pigweed//pw_kernel/tooling:system_image.bzl", "system_image")
load("@pigweed//pw_kernel/tooling:target_codegen.bzl", "target_codegen")
load("@pigweed//pw_kernel/tooling:target_linker_script.bzl", "target_linker_script")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//target/ast10x0:defs.bzl", "TARGET_COMPATIBLE_WITH", "system_image_test")

# ── Master image (device A) ───────────────────────────────────────────────────

filegroup(
    name = "system_config",
    srcs = ["system.json5"],
)

target_codegen(
    name = "codegen",
    arch = "@pigweed//pw_kernel/arch/arm_cortex_m:arch_arm_cortex_m",
    system_config = ":system_config",
    target_compatible_with = TARGET_COMPATIBLE_WITH,
)

target_linker_script(
    name = "linker_script",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    template = "//target/ast10x0:linker_script_template",
)

rust_binary(
    name = "target",
    srcs = ["target.rs"],
    edition = "2024",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        ":codegen",
        ":linker_script",
        "//target/ast10x0:entry",
        "//target/ast10x0/peripherals",
        "@ast1060_pac",
        "@pigweed//pw_kernel/arch/arm_cortex_m:arch_arm_cortex_m",
        "@pigweed//pw_kernel/kernel",
        "@pigweed//pw_kernel/subsys/console:console_backend",
        "@pigweed//pw_kernel/target:target_common",
        "@pigweed//pw_kernel/userspace",
    ],
)

rust_app(
    name = "i2c_server",
    srcs = ["i2c_server_main.rs"],
    codegen_crate_name = "app_i2c_server",
    edition = "2024",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        "//drivers/i2c/server-runtime:i2c_server_runtime",
        "//target/ast10x0/backend/i2c:i2c_backend_ast10x0",
        "//target/ast10x0/peripherals",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_log/rust:pw_log",
    ],
)

rust_app(
    name = "mctp_nop_shutdown",
    srcs = ["shutdown_main.rs"],
    codegen_crate_name = "app_mctp_nop_shutdown",
    edition = "2024",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        "@pigweed//pw_kernel/userspace",
    ],
)

system_image(
    name = "mctp_server_nop_image",
    apps = [":i2c_server", ":mctp_nop_shutdown"],
    kernel = ":target",
    platform = "//target/ast10x0",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
)

# ── Peer image (device B) ─────────────────────────────────────────────────────

filegroup(
    name = "peer_system_config",
    srcs = ["peer_system.json5"],
)

target_codegen(
    name = "peer_codegen",
    arch = "@pigweed//pw_kernel/arch/arm_cortex_m:arch_arm_cortex_m",
    system_config = ":peer_system_config",
    target_compatible_with = TARGET_COMPATIBLE_WITH,
)

target_linker_script(
    name = "peer_linker_script",
    system_config = ":peer_system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    template = "//target/ast10x0:linker_script_template",
)

rust_binary(
    name = "peer_target",
    srcs = ["target.rs"],
    aliases = {":peer_codegen": "codegen"},
    edition = "2024",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        ":peer_codegen",
        ":peer_linker_script",
        "//target/ast10x0:entry",
        "//target/ast10x0/peripherals",
        "@ast1060_pac",
        "@pigweed//pw_kernel/arch/arm_cortex_m:arch_arm_cortex_m",
        "@pigweed//pw_kernel/kernel",
        "@pigweed//pw_kernel/subsys/console:console_backend",
        "@pigweed//pw_kernel/target:target_common",
        "@pigweed//pw_kernel/userspace",
    ],
)

rust_app(
    name = "i2c_server_peer",
    srcs = ["i2c_server_main_peer.rs"],
    codegen_crate_name = "app_i2c_server_peer",
    edition = "2024",
    system_config = ":peer_system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        "//drivers/i2c/server-runtime:i2c_server_runtime",
        "//target/ast10x0/backend/i2c:i2c_backend_ast10x0",
        "//target/ast10x0/peripherals",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_log/rust:pw_log",
    ],
)

rust_app(
    name = "mctp_nop_shutdown_peer",
    srcs = ["shutdown_main.rs"],
    codegen_crate_name = "app_mctp_nop_shutdown_peer",
    edition = "2024",
    system_config = ":peer_system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        "@pigweed//pw_kernel/userspace",
    ],
)

system_image(
    name = "mctp_server_nop_peer_image",
    apps = [":i2c_server_peer", ":mctp_nop_shutdown_peer"],
    kernel = ":peer_target",
    platform = "//target/ast10x0",
    system_config = ":peer_system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
)

# ── Test ──────────────────────────────────────────────────────────────────────

system_image_test(
    name = "mctp_server_nop_test",
    image = ":mctp_server_nop_image",
    slave_image = ":mctp_server_nop_peer_image",
    tags = ["hardware"],
    target_compatible_with = select({
        "//target/ast10x0:qemu_enabled": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)
